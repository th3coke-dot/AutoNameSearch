{
  "name": "autonamesearch",
  "version": "0.1.0",
  "private": true,
  "description": "Venture-capital grade naming pipeline — phonetic generation, domain/TM/company screening, brand scoring",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
